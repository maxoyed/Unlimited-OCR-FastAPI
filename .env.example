# --- sglang OpenAI-compatible endpoint ---
# Base URL of your sglang server (must include the trailing /v1).
SGLANG_BASE_URL=http://localhost:30000/v1
# API key for the sglang server. Use "EMPTY" if the server has no auth.
SGLANG_API_KEY=EMPTY
# Served model name as exposed by sglang (--served-model-name or model path).
OCR_MODEL=baidu/Unlimited-OCR

# --- OCR behaviour ---
OCR_PROMPT=OCR this image. Return all text content faithfully.
OCR_MAX_TOKENS=8192
OCR_TEMPERATURE=0.0
OCR_MAX_CONCURRENCY=8
OCR_REQUEST_TIMEOUT=300

# --- PDF rendering ---
PDF_DPI=200

# --- Upload limits ---
MAX_FILE_SIZE_MB=50
MAX_FILES=20
