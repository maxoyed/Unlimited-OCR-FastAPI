# --- sglang server ---
# Server root URL. "/v1/chat/completions" is appended automatically, so a
# trailing /v1 is optional.
SGLANG_BASE_URL=http://localhost:30000
# API key for the sglang server. Leave empty (or "EMPTY") if the server has no
# auth; otherwise it is sent as a Bearer token.
SGLANG_API_KEY=
# Served model name as exposed by sglang.
OCR_MODEL=Unlimited-OCR

# --- behaviour ---
OCR_MAX_CONCURRENCY=4
OCR_REQUEST_TIMEOUT=1200

# --- PDF rendering ---
PDF_DPI=300

# --- upload limits ---
MAX_FILE_SIZE_MB=50
MAX_FILES=20
