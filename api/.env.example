# --- vLLM server ---
# Server root URL. "/v1/chat/completions" is appended automatically, so a
# trailing /v1 is optional.
VLLM_BASE_URL=http://localhost:8000
# API key for the vLLM server. Leave empty (or "EMPTY") if the server has no
# auth; otherwise it is sent as a Bearer token.
VLLM_API_KEY=
# Served model name as exposed by vLLM.
OCR_MODEL=baidu/Unlimited-OCR

# --- behaviour ---
OCR_MAX_CONCURRENCY=4
OCR_REQUEST_TIMEOUT=1200
OCR_MAX_TOKENS=8192

# --- PDF rendering ---
PDF_DPI=300

# --- upload limits ---
MAX_FILE_SIZE_MB=50
MAX_FILES=20

# --- CORS (browser demo frontend) ---
# Comma-separated allowed origins. "*" allows any origin.
CORS_ALLOW_ORIGINS=*
