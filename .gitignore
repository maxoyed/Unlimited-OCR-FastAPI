# Monorepo root. Each sub-project keeps its own ignores:
#   api/.gitignore  -> Python backend
#   web/.gitignore  -> Vite/React frontend

# Local environment / secrets (compose reads root .env for substitution)
.env
.env.*
!.env.example

# Python virtualenvs created at the repo root
.venv/
venv/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
